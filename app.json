{
  "expo": {
    "name": "EventPro",
    "slug": "Event-Pro-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/eventProLogo.png",
    "scheme": "eventpromobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/eventProLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#6F00FF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6F00FF",
        "foregroundImage": "./assets/images/eventProLogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      
    }
  }
}